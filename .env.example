# Copy this file to .env and edit it. Lines starting with # are comments.
# Demo mode needs NO API key. Leave LLM_PROVIDER=mock to run everything offline.

# mock       = demo mode: deterministic agent workflows over the sample documents (default)
# openai     = live mode using an OpenAI-compatible Chat Completions API
# anthropic  = live mode using the Anthropic Messages API
LLM_PROVIDER=mock

# Optional model override. Leave blank to use the provider default.
LLM_MODEL=

# Only needed when LLM_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=
# Optional: point at any OpenAI-compatible endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1

# Only needed when LLM_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=

# Execution limits (validated at start-up)
LLM_TIMEOUT_SECONDS=30
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=0.5

# SQLite database location. Relative paths are resolved from the project folder.
DB_PATH=data/orchestration.db

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
